<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lastcore.node-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>BUNDLE_AGENT_PLACEHOLDER</string>
        <string>--env-file</string>
        <string>ENV_FILE_PLACEHOLDER</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>STDOUT_PATH_PLACEHOLDER</string>
    <key>StandardErrorPath</key>
    <string>STDERR_PATH_PLACEHOLDER</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
