# LastCore node-agent configuration (copy to a private path, e.g. %LOCALAPPDATA%\LastCore\env or ~/.lastcore/env)
# Values are read by the launch wrapper scripts and exported as environment variables.
# Keep this file private: it may contain the registration token during bootstrap.
NODE_AGENT_CONTROLLER_URL=http://127.0.0.1:8000
NODE_AGENT_ENDPOINT=http://127.0.0.1:9101
NODE_AGENT_AVAILABLE_MEMORY_MB=4096
NODE_AGENT_COMPUTE_WEIGHT=2.0
NODE_AGENT_STATE_DIR=~/.lastcore/node-agent
# Required explicitly: stage = tiny CPU inference; demo = simulation only.
NODE_AGENT_EXECUTOR=stage
# Optional custom checkpoint uses the same LastCore tiny architecture, not an arbitrary LLM.
NODE_AGENT_MODEL_CONFIG=
NODE_AGENT_WEIGHTS=
NODE_AGENT_COMPLETE_AFTER=1
NODE_AGENT_HEARTBEAT_INTERVAL=10
NODE_AGENT_POLL_INTERVAL=1
# Bootstrap only: needed until the first successful registration persists
# node-credentials.json in the state dir. Remove it afterwards.
NODE_AGENT_REGISTRATION_TOKEN=
